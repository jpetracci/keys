# Local development values. With DEBUG off the app refuses to start until
# SECRET_KEY is replaced with a private value.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API from another origin. Local
# development does not need this: the Vite dev server proxies /api to Django,
# and with DEBUG=True its own origin (http://localhost:5173) is allowed too.
# The API has no login, so only list origins you would trust with every
# transaction. There is no "allow all" setting.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example

# Local SQLite (recommended for dev). With USE_SQLITE=True the PostgreSQL
# values below are ignored.
USE_SQLITE=True
SQLITE_NAME=backend.sqlite3

# PostgreSQL, used when USE_SQLITE is not True. Either one connection URL
# (the form Coolify shows for its databases)...
# DATABASE_URL=postgres://user:password@host:5432/database
# ...or these separate values, which apply when DB_NAME is set.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PWD=
DB_HOST=
DB_PORT=5432

# Keep the build context small and keep private files out of the image.
.git
.github
.claude
README.md

# Secrets, databases and bank statements never belong in an image. A local
# build sees files that git ignores, so they are listed here again.
**/.env
**/.env.*
**/*.env
**/*.local
**/*.sqlite3
**/*.sqlite3-*
**/statements

# macOS folder metadata.
**/.DS_Store

# Rebuilt inside the image.
**/node_modules
**/dist
**/staticfiles
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/env
